{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true,
    "node": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/.shaker-tmp*/**",
    "packages/site/**",
    "packages/vue-shaker/tests/fixtures/**",
    "packages/vue-shaker/engine-rs/**"
  ]
}
