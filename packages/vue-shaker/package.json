{
  "name": "vue-shaker",
  "version": "0.0.0",
  "description": "Tree shaking for Vue components",
  "license": "MIT",
  "author": "baseballyama",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baseballyama/vue-shaker.git",
    "directory": "packages/vue-shaker"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/types/src/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./node": {
      "types": "./dist/types/src/scan.d.ts",
      "import": "./dist/scan.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rollup -c",
    "build:wasm": "wasm-pack build engine-rs --target nodejs --release --out-dir pkg",
    "prepack": "rollup -c",
    "dev": "rollup -cw",
    "test:watch": "vitest",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/parser": "^7.26.0",
    "@vue/compiler-dom": "^3.5.13",
    "@vue/compiler-sfc": "^3.5.13",
    "magic-string": "0.30.10",
    "postcss": "^8.4.49",
    "postcss-selector-parser": "^6.1.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "25.0.8",
    "@rollup/plugin-node-resolve": "15.2.3",
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "11.1.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/server-renderer": "^3.5.13",
    "rollup": "4.18.0",
    "tslib": "2.6.2",
    "vite": "^5.4.11",
    "vue": "^3.5.13"
  },
  "peerDependencies": {
    "vue": "^3"
  }
}
